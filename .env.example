# Copy to .env.local and fill in. Never commit .env.local.

# W&B API key: https://wandb.ai/authorize
WANDB=
# The owner journal's W&B project, as in wandb.ai/<entity>/<project>
WANDB_ENTITY=
WANDB_PROJECT=

# Supabase project URL and service role key (Project settings -> API). Server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Passcode that unlocks owner mode (footer > Owner). Without it the app is read-only for everyone.
OWNER_PASSCODE=
# Optional: models to try in order when one is out of quota or overloaded.
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
